{
  "Q_block": {
    "description": "block之间的旋转矩阵",
    "folder": "Q_block",
    "layers": ["self_attn.q_a_proj","mlp.gate"],
    "save_mode": "separate",
    "filename_template": "sample_{idx}_layer_{layer_idx}_Q_block.pt",
    "train_args": {
      "train_data": "layer_wise",
      "train_batch_size": 128,
      "num_epochs": 10,
      "learning_rate": 1e-3,
      "weight_decay": 0.01,
      "optimizer": "adamw",
      "cos_lr": true,
      "warmup_ratio": 0.05,
      "init_mode": "hadamard"
    }
  },
  
  "Q_q_lowrank": {
    "description": "q 低秩投影层",
    "folder": "Q_q_lowrank",
    "layers": ["self_attn.q_b_proj"],
    "save_mode": "combined",
    "filename_template": "layer_{layer_idx}_Q_q_lowrank.pt",
    "sampling": {"max_tokens": 2048},
    "train_args": {
      "train_data": "layer_wise",
      "train_batch_size": 128,
      "num_epochs": 10,
      "learning_rate": 1e-3,
      "weight_decay": 0.01,
      "optimizer": "adamw",
      "cos_lr": true,
      "warmup_ratio": 0.05,
      "init_mode": "hadamard"
    }
  },
  
  "Q_kv_lowrank": {
    "description": "KV 低秩投影层",
    "folder": "Q_kv_lowrank",
    "layers": ["self_attn.kv_b_proj"],
    "save_mode": "combined",
    "train_data": "layer_wise",
    "filename_template": "layer_{layer_idx}_Q_kv_lowrank.pt"
  }
}